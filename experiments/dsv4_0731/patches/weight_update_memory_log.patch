+def log_memory(tag: str, tp_rank: int, bucket: Optional[int] = None) -> None:
+    """Report device and host memory around a weight update.
+
+    ``free`` comes from the driver rather than the caching allocator, so it also
+    accounts for memory the allocator never sees — imported IPC mappings among
+    it. A run whose allocator figures are flat while ``free`` falls is leaking
+    outside the allocator.
+
+    An update is delivered as hundreds of buckets, so bucket-level reports are
+    sampled; the report at the end of an update is always emitted.
+    """
+    free, total = torch.cuda.mem_get_info()
+    with open("/proc/self/statm") as f:
+        rss = int(f.read().split()[1]) * os.sysconf("SC_PAGE_SIZE")
+    mib = 1 << 20
+    logger.info(
+        "weight-update memory %s rank=%d bucket=%s alloc=%dMiB reserved=%dMiB "
+        "free=%dMiB used=%dMiB rss=%dMiB",
+        tag,
+        tp_rank,
+        bucket,
+        torch.cuda.memory_allocated() // mib,
+        torch.cuda.memory_reserved() // mib,
+        free // mib,
+        (total - free) // mib,
+        rss // mib,
+    )
+
