# MXFP8 training against the release rollout recipe: MXFP4 weights, MXFP8
# activations. Shares phase 1's trainer, so the mismatch delta isolates the
# rollout weight format.
MODEL_NAME=DeepSeek-V4-Flash-0731
PRECISION=mxfp8-fp4r
INIT_MODEL_SOURCE=hf
ROLLOUT_WEIGHT_SOURCE=trainer
NUM_ROLLOUT=1

REMATERIALIZE_PARAM_FROM_MASTER_WEIGHT=0
OFFLOAD_TRAIN_TARGET=disk
OPTIMIZER_OFFLOAD=0
USE_FAULT_TOLERANCE=0

# Dynamic sampling discards groups whose rewards all agree. Until the rollout is
# known to answer anything correctly, that filter resamples without converging,
# so this phase runs without it.
MODE=debug_minimal
ENABLE_EVAL=0
LOG_PASSRATE=1

UPDATE_WEIGHT_BUFFER_SIZE=1073741824
SGLANG_MEM_FRACTION_STATIC=0.6

# The comparison does not model the MXFP4 kernel layout and would report a
# difference that is not one; validate_mxfp4_hot_reload.py covers it instead.
MILES_EXTRA_ARGS_APPEND=""
SGLANG_PATCH_FILE="/workspace/miles/experiments/aga_dsv4_flash/patches/sglang_tensor_update_cuda_sync.patch /workspace/miles/experiments/dsv4_0731/patches/mxfp4_trtllm_hot_reload.patch /workspace/miles/experiments/dsv4_0731/patches/mxfp4_trtllm_memory_saver_clamp.patch /workspace/miles/experiments/dsv4_0731/patches/weight_update_memory_log.patch"

# Left on the tag: pyxis resolves a tag per platform, but fetching this image's
# digest directly lands on its OCI index and enroot cannot parse that. Pinning
# needs the platform manifest instead — for this image, linux/arm64 is
# sha256:f2312237a3e5c846c858bd9bc679959e2f76aedcf36282e0d8675589bb8b166e —
# and that form has not been shown to import here yet.
CONTAINER_IMAGE=radixark/miles:latest
