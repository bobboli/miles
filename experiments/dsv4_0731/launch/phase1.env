# MXFP8 training against MXFP8 rollout.
#
# This is the configuration 431471 completed four steps with. The launcher's
# own defaults are not this, and taking them moves several settings at once.
MODEL_NAME=DeepSeek-V4-Flash-0731
PRECISION=mxfp8
INIT_MODEL_SOURCE=hf
ROLLOUT_WEIGHT_SOURCE=trainer
NUM_ROLLOUT=4
ENABLE_R3=1

# Frozen routers are absent from the DDP parameter buffers, so rematerialization
# cannot cover them and asserts during actor init.
REMATERIALIZE_PARAM_FROM_MASTER_WEIGHT=0
OFFLOAD_TRAIN_TARGET=disk
OPTIMIZER_OFFLOAD=0
USE_FAULT_TOLERANCE=0

MODE=normal
ENABLE_EVAL=0
LOG_PASSRATE=1

UPDATE_WEIGHT_BUFFER_SIZE=268435456
SGLANG_MEM_FRACTION_STATIC=0.6

# A trainer-owned rollout starts from a dummy allocation layout, so there is no
# checkpoint-loaded tensor snapshot to compare against before the initial sync.
MILES_EXTRA_ARGS_APPEND=""
SGLANG_PATCH_FILE="/workspace/miles/experiments/aga_dsv4_flash/patches/sglang_tensor_update_cuda_sync.patch /workspace/miles/experiments/dsv4_0731/patches/sglang_r3_hash_topk_capture.patch /workspace/miles/experiments/dsv4_0731/patches/weight_update_memory_log.patch"

# Left on the tag: pyxis resolves a tag per platform, but fetching this image's
# digest directly lands on its OCI index and enroot cannot parse that. Pinning
# needs the platform manifest instead — for this image, linux/arm64 is
# sha256:f2312237a3e5c846c858bd9bc679959e2f76aedcf36282e0d8675589bb8b166e —
# and that form has not been shown to import here yet.
CONTAINER_IMAGE=radixark/miles:latest
