# MXFP8 training against MXFP8 rollout.
#
# This is the configuration 431471 completed four steps with. The launcher's
# own defaults are not this, and taking them moves several settings at once.
MODEL_NAME=DeepSeek-V4-Flash-0731
PRECISION=mxfp8
NUM_ROLLOUT=4

# Frozen routers are absent from the DDP parameter buffers, so rematerialization
# cannot cover them and asserts during actor init.
REMATERIALIZE_PARAM_FROM_MASTER_WEIGHT=0
OFFLOAD_TRAIN_TARGET=disk
OPTIMIZER_OFFLOAD=0
USE_FAULT_TOLERANCE=0

MODE=normal
ENABLE_EVAL=0
LOG_PASSRATE=1

UPDATE_WEIGHT_BUFFER_SIZE=268435456
SGLANG_MEM_FRACTION_STATIC=0.6

MILES_EXTRA_ARGS_APPEND="--check-weight-update-equal"
SGLANG_PATCH_FILE="/workspace/miles/experiments/aga_dsv4_flash/patches/sglang_tensor_update_cuda_sync.patch /workspace/miles/experiments/dsv4_0731/patches/weight_update_memory_log.patch"

# Pinned so the SGLang patches keep applying to the sources they were
# generated from. This is the digest local validation runs against.
CONTAINER_IMAGE=radixark/miles@sha256:08be00658cd24eaa364ca4ad0b1a3911dfbe4adc04fd0c148e4241402fb40812
